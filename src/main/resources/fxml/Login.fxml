<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650" prefWidth="1000" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.controller.LoginController">

    <HBox prefHeight="560" prefWidth="900">

        <!-- ==============================
             LEFT SIDE - LIBRARY
             ============================== -->

        <StackPane prefHeight="560" prefWidth="500" styleClass="library-section">

               <VBox alignment="CENTER_LEFT" maxWidth="430" spacing="15">
      
                      <!-- MAIN TITLE -->
      
                      <Label styleClass="library-title" text="Library Management " />

                   <Label styleClass="library-subtitle" text="Access knowledge, build your future." />
      
                      <Label styleClass="library-description" text="Manage books, members and borrowing records easily." wrapText="true" />

               </VBox>

        </StackPane>


        <!-- ==============================
             RIGHT SIDE - LOGIN
             ============================== -->

        <StackPane prefHeight="560" prefWidth="400">

            <VBox alignment="CENTER" maxWidth="430.0" prefHeight="660.0" prefWidth="430.0" spacing="18" styleClass="login-card">

                <!-- LOGIN TITLE -->

                <Label styleClass="login-title" text="Welcome Back!" />

                <Label styleClass="login-subtitle" text="Please login to continue" />


                <!-- USERNAME -->

                <VBox maxWidth="300" spacing="7">

                    <Label styleClass="field-label" text="Username" />

                    <TextField fx:id="usernameField" prefHeight="45" prefWidth="300" promptText="Enter your username" styleClass="input-field" />

                </VBox>


                <!-- PASSWORD -->

                <VBox maxWidth="300" spacing="7">

                    <Label styleClass="field-label" text="Password" />

                    <PasswordField fx:id="passwordField" prefHeight="45" prefWidth="300" promptText="Enter your password" styleClass="input-field" />

                </VBox>


                <!-- ERROR MESSAGE -->

                <Label fx:id="errorLabel" maxWidth="300" styleClass="error-label" text="" wrapText="true" />


                <!-- LOGIN BUTTON -->

                <Button onAction="#handleLogin" prefHeight="45" prefWidth="300" styleClass="login-button" text="LOGIN" />


                <!-- CLEAR BUTTON -->

                <Button onAction="#handleClear" prefHeight="42" prefWidth="300" styleClass="clear-button" text="CLEAR" />


                <!-- FOOTER -->

                <Label styleClass="footer-label" text="Library Management System • 2026" />

            </VBox>

        </StackPane>

    </HBox>

</StackPane>
