<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.Login.ReturnBookController"
            stylesheets="@../css/style.css"
            styleClass="dashboard-root"
            prefWidth="1200"
            prefHeight="700">

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox prefWidth="260"
              spacing="12"
              styleClass="sidebar">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Label text="LIBRARY"
                   styleClass="sidebar-title"/>

            <Label text="Management System"
                   styleClass="sidebar-subtitle"
                   wrapText="true"/>

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets top="20"/>
                </padding>

                <Button text="Dashboard"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Add Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Add Member"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Manage Members"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Issue Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Return Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button-active"/>

                <Button text="Borrowing History"
                        maxWidth="Infinity"
                        prefHeight="45"
                        wrapText="true"
                        styleClass="sidebar-button"/>

            </VBox>

            <Button text="LOGOUT"
                    maxWidth="Infinity"
                    prefHeight="45"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <VBox spacing="25"
              styleClass="dashboard-content">

            <padding>
                <Insets top="35"
                        right="50"
                        bottom="35"
                        left="50"/>
            </padding>


            <!-- HEADER -->

            <VBox spacing="6">

                <Label text="Return Book"
                       styleClass="dashboard-title"/>

                <Label text="Process a returned library book"
                       styleClass="dashboard-subtitle"/>

            </VBox>


            <!-- FORM CARD -->

            <VBox spacing="25"
                  styleClass="form-card">

                <Label text="Return Book Information"
                       styleClass="form-card-title"/>


                <!-- BORROWED BOOK -->

                <VBox spacing="8">

                    <Label text="Select Borrowed Book"
                           styleClass="form-label"/>

                    <ComboBox fx:id="borrowedBookComboBox"
                              promptText="Select borrowed book"
                              prefHeight="45"
                              maxWidth="Infinity"
                              styleClass="form-input"/>

                </VBox>


                <!-- MEMBER INFO -->

                <HBox spacing="25">

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Member"
                               styleClass="form-label"/>

                        <TextField fx:id="memberField"
                                   promptText="Member information"
                                   editable="false"
                                   prefHeight="45"
                                   styleClass="form-input"/>

                    </VBox>


                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Book"
                               styleClass="form-label"/>

                        <TextField fx:id="bookField"
                                   promptText="Book information"
                                   editable="false"
                                   prefHeight="45"
                                   styleClass="form-input"/>

                    </VBox>

                </HBox>


                <!-- BORROWED / DUE DATE -->

                <HBox spacing="25">

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Borrowed Date"
                               styleClass="form-label"/>

                        <DatePicker fx:id="borrowedDatePicker"
                                    prefHeight="45"
                                    maxWidth="Infinity"
                                    styleClass="form-input"/>

                    </VBox>


                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Due Date"
                               styleClass="form-label"/>

                        <DatePicker fx:id="dueDatePicker"
                                    prefHeight="45"
                                    maxWidth="Infinity"
                                    styleClass="form-input"/>

                    </VBox>

                </HBox>


                <!-- RETURN DATE -->

                <VBox spacing="8">

                    <Label text="Return Date"
                           styleClass="form-label"/>

                    <DatePicker fx:id="returnDatePicker"
                                prefHeight="45"
                                maxWidth="Infinity"
                                styleClass="form-input"/>

                </VBox>


                <!-- OVERDUE STATUS -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Status:"
                           styleClass="form-label"/>

                    <Label fx:id="statusLabel"
                           text="Not Checked"
                           styleClass="form-message"/>

                </HBox>


                <!-- MESSAGE -->

                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       styleClass="form-message"/>


                <!-- BUTTONS -->

                <HBox spacing="15"
                      alignment="CENTER_RIGHT">

                    <Button text="CLEAR"
                            onAction="#handleClear"
                            prefWidth="130"
                            prefHeight="45"
                            styleClass="clear-button"/>

                    <Button text="RETURN BOOK"
                            onAction="#handleReturnBook"
                            prefWidth="160"
                            prefHeight="45"
                            styleClass="primary-button"/>

                </HBox>

            </VBox>


            <!-- INFO -->

            <HBox styleClass="info-card">

                <Label text="Tip: Return the book before or on the due date to avoid an overdue status."
                       styleClass="info-text"
                       wrapText="true"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>