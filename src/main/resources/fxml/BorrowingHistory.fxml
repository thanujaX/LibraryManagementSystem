<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.Login.BorrowingHistoryController"
            stylesheets="@../css/style.css"
            styleClass="dashboard-root"
            prefWidth="1200"
            prefHeight="700">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="260"
              spacing="12"
              styleClass="sidebar">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Label text="LIBRARY"
                   styleClass="sidebar-title"/>

            <Label text="Management System"
                   styleClass="sidebar-subtitle"
                   wrapText="true"/>

            <VBox spacing="10"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets top="20"/>
                </padding>

                <Button text="Dashboard"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Add Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Add Member"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Manage Members"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Issue Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Return Book"
                        maxWidth="Infinity"
                        prefHeight="45"
                        styleClass="sidebar-button"/>

                <Button text="Borrowing History"
                        maxWidth="Infinity"
                        prefHeight="45"
                        wrapText="true"
                        styleClass="sidebar-button-active"/>

            </VBox>

            <Button text="LOGOUT"
                    maxWidth="Infinity"
                    prefHeight="45"
                    styleClass="logout-button"/>

        </VBox>
    </left>


    <!-- MAIN CONTENT -->
    <center>

        <VBox spacing="20"
              styleClass="dashboard-content">

            <padding>
                <Insets top="35"
                        right="40"
                        bottom="35"
                        left="40"/>
            </padding>


            <!-- PAGE TITLE -->
            <VBox spacing="6">

                <Label text="Borrowing History"
                       styleClass="dashboard-title"/>

                <Label text="View all book borrowing records"
                       styleClass="dashboard-subtitle"/>

            </VBox>


            <!-- SEARCH BAR -->
            <HBox spacing="15">

                <TextField fx:id="searchField"
                           promptText="Search by Member ID or Book Title..."
                           prefHeight="45"
                           HBox.hgrow="ALWAYS"
                           styleClass="form-input"/>

                <Button text="SEARCH"
                        onAction="#handleSearch"
                        prefWidth="120"
                        prefHeight="45"
                        styleClass="primary-button"/>

                <Button text="CLEAR"
                        onAction="#handleClearSearch"
                        prefWidth="120"
                        prefHeight="45"
                        styleClass="clear-button"/>

            </HBox>


            <!-- HISTORY TABLE -->
            <VBox spacing="15"
                  styleClass="form-card"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">

                    <Label text="Borrowing Records"
                           styleClass="form-card-title"
                           HBox.hgrow="ALWAYS"/>

                    <Label fx:id="historyCountLabel"
                           text="Records: 0"
                           styleClass="form-message"/>

                </HBox>


                <TableView fx:id="historyTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="memberIdColumn"
                                     text="Member ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="bookTitleColumn"
                                     text="Book Title"
                                     prefWidth="230"/>

                        <TableColumn fx:id="issueDateColumn"
                                     text="Issue Date"
                                     prefWidth="150"/>

                        <TableColumn fx:id="dueDateColumn"
                                     text="Due Date"
                                     prefWidth="150"/>

                        <TableColumn fx:id="returnDateColumn"
                                     text="Return Date"
                                     prefWidth="150"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- INFO -->
            <HBox styleClass="info-card">

                <Label text="Tip: Use the search box to quickly find a member or book borrowing record."
                       styleClass="info-text"
                       wrapText="true"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>